# Supabase — Settings → API Keys in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — resend.com dashboard (Phase 4)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
BOOKING_NOTIFICATION_TO_EMAIL=

# Google Cloud Translate — console.cloud.google.com, enable the "Cloud
# Translation API" on a project, then create an API key under Credentials.
GOOGLE_TRANSLATE_API_KEY=
