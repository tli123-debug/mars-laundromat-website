# Supabase — Settings → API Keys in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — resend.com dashboard (Phase 4)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
BOOKING_NOTIFICATION_TO_EMAIL=

# Anthropic — console.anthropic.com, used to machine-translate customer notes
# to Simplified Chinese for admin staff. Best-effort: missing/invalid key
# just means special_instructions_zh stays null, booking creation is unaffected.
ANTHROPIC_API_KEY=

# Apple/iCloud calendar sync (Part 2) — server-only, never NEXT_PUBLIC_.
# See the runbook at docs-internal/calendar-sync-runbook.md for the full
# setup order. Missing/empty values mean sync is inert (no CalDAV calls
# ever attempted), not broken — safe to leave unset until setup is
# complete. There is deliberately no ICLOUD_CALDAV_CALENDAR_URL env var:
# the target calendar's identity lives in calendar_sync_config.
# active_calendar_identity (set via SQL — see the runbook), not here,
# so switching calendars is a database change, never a redeploy.

# The dedicated Mars Laundromat Apple Account's email + an app-specific
# password generated at account.apple.com — never the account's real
# password. Used only by src/lib/calendar-sync/ and scripts/discover-
# caldav-calendars.ts.
ICLOUD_CALDAV_USERNAME=
ICLOUD_CALDAV_APP_PASSWORD=

# A long random string only you and Supabase's pg_net recovery call know
# — the cron endpoint (src/app/api/cron/calendar-sync/route.ts) rejects
# any request whose Authorization: Bearer header doesn't match this
# exactly. Generate with `openssl rand -hex 32` or similar.
CALENDAR_SYNC_SECRET=

# A dedicated Supabase Auth login (created once via the Supabase
# dashboard, never scripted — see the runbook) whose access is scoped by
# RLS to exactly the calendar-sync tables, nothing else. Not a staff
# login — do not reuse an admin's own credentials here.
CALENDAR_SYNC_WORKER_EMAIL=
CALENDAR_SYNC_WORKER_PASSWORD=
